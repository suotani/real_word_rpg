.d-flex.justify-content-between.align-items-center.mb-4
  %h2.mb-0 FXトレードボット設定の編集
  = link_to '← 戻る', admin_fx_bot_setting_path, class: 'btn btn-outline-secondary'

.alert.alert-danger
  %strong ⚠ 実資金を扱う機能です。
  変更は次回のバッチ実行から即反映されます。緊急停止は「稼働状況」のチェックを外してください。

.card
  .card-body
    = form_with model: @fx_bot_setting, url: admin_fx_bot_setting_path, method: :patch, local: true, scope: :fx_bot_setting do |f|
      - if @fx_bot_setting.errors.any?
        .alert.alert-danger
          %ul.mb-0
            - @fx_bot_setting.errors.full_messages.each do |msg|
              %li= msg

      .mb-3.form-check
        = f.check_box :enabled, class: 'form-check-input'
        = f.label :enabled, '稼働状況（オンにすると実際に発注します）', class: 'form-check-label fw-bold'

      .mb-3
        = f.label :size, '発注サイズ（通貨単位。最小100）', class: 'form-label fw-bold'
        = f.number_field :size, min: 1, step: 1, class: 'form-control'

      .mb-3
        = f.label :stop_loss_yen, '損切り（円）', class: 'form-label fw-bold'
        = f.number_field :stop_loss_yen, min: 0, step: 'any', class: 'form-control'

      .row.mb-3
        .col-sm-6
          %label.form-label.fw-bold エントリー時刻（JST）
          .d-flex.align-items-center.gap-2
            = f.number_field :entry_hour, min: 0, max: 23, class: 'form-control', style: 'width: 6rem;'
            %span :
            = f.number_field :entry_min, min: 0, max: 59, class: 'form-control', style: 'width: 6rem;'
        .col-sm-6
          %label.form-label.fw-bold 決済時刻（JST）
          .d-flex.align-items-center.gap-2
            = f.number_field :exit_hour, min: 0, max: 23, class: 'form-control', style: 'width: 6rem;'
            %span :
            = f.number_field :exit_min, min: 0, max: 59, class: 'form-control', style: 'width: 6rem;'

      .text-muted.small.mb-3
        ※ 時刻の前提・スワップ費用については docs/fx_trade_bot.md を参照してください。

      .mt-4
        = f.submit '更新する', class: 'btn btn-primary'
        = link_to 'キャンセル', admin_fx_bot_setting_path, class: 'btn btn-outline-secondary ms-2'
