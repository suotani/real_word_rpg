.d-flex.justify-content-between.align-items-center.mb-4
  %h2= "#{@model_name.humanize} ##{@record.id} 編集"
  = link_to '詳細へ戻る', admin_resource_record_path(model_name: @model_name, id: @record.id), class: 'btn btn-outline-secondary'

.card
  .card-body
    = render 'form', record: @record, model: @model, model_name: @model_name
