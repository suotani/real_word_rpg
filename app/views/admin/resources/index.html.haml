- columns = all_columns(@model)

.d-flex.justify-content-between.align-items-center.mb-4
  %h2= @model_name.humanize + ' 一覧'
  = link_to '+ 新規作成', admin_new_resource_record_path(model_name: @model_name), class: 'btn btn-primary'

- if (pred = text_search_predicate)
  = search_form_for @q, url: admin_resource_record_list_path(model_name: @model_name), html: { class: 'mb-4' } do |f|
    .input-group
      = f.search_field pred.to_sym, class: 'form-control', placeholder: '検索...'
      = f.submit '検索', class: 'btn btn-outline-secondary'

- if @records.empty?
  .alert.alert-info レコードがありません

- else
  .table-responsive
    %table.table.table-bordered.table-hover.table-sm
      %thead.table-dark
        %tr
          - columns.each do |col|
            %th= col
          %th 操作
      %tbody
        - @records.each do |record|
          %tr
            - columns.each do |col|
              %td
                - val = record.send(col)
                - if val.nil?
                  %span.text-muted null
                - elsif val == true
                  %span.badge.bg-success はい
                - elsif val == false
                  %span.badge.bg-secondary いいえ
                - else
                  - name = associated_name(record, col)
                  - if name
                    = truncate("#{name} (#{val})", length: 40)
                  - elsif val.is_a?(Time) || val.is_a?(DateTime)
                    = val.strftime('%Y-%m-%d %H:%M:%S')
                  - else
                    = truncate(val.to_s, length: 40)
            %td.text-nowrap
              = link_to '編集', admin_edit_resource_record_path(model_name: @model_name, id: record.id), class: 'btn btn-sm btn-outline-warning'
              = link_to '削除', admin_resource_record_path(model_name: @model_name, id: record.id),
                method: :delete,
                data: { confirm: "本当に削除しますか？" },
                class: 'btn btn-sm btn-outline-danger ms-1'
              - if @model_name == 'user' && !record.admin? && record.id != current_user.id
                = button_to 'ログイン', admin_impersonation_path(user_id: record.id),
                    method: :post,
                    data: { confirm: "#{record.name} としてログインしますか？" },
                    class: 'btn btn-sm btn-outline-info ms-1'

  - if @records.respond_to?(:total_pages)
    = paginate @records
