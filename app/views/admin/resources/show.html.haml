.d-flex.justify-content-between.align-items-center.mb-4
  %h2= "#{@model_name.humanize} ##{@record.id}"
  .btn-group
    = link_to '編集', admin_edit_resource_record_path(model_name: @model_name, id: @record.id), class: 'btn btn-warning'
    = link_to '削除', admin_resource_record_path(model_name: @model_name, id: @record.id),
      method: :delete,
      data: { confirm: "本当に削除しますか？" },
      class: 'btn btn-danger'
    = link_to '一覧へ戻る', admin_resource_record_list_path(model_name: @model_name), class: 'btn btn-outline-secondary'

.card
  .card-body
    %table.table.table-bordered.mb-0
      %tbody
        - @model.column_names.each do |col|
          %tr
            %th.bg-light.w-25= col
            %td
              - val = @record.send(col)
              - if val.nil?
                %span.text-muted null
              - elsif val == true
                %span.badge.bg-success はい
              - elsif val == false
                %span.badge.bg-secondary いいえ
              - else
                %pre.mb-0.pre-wrap= val
