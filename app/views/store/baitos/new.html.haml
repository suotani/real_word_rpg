.container.py-4
  .row.justify-content-center
    .col-lg-6.col-md-8

      .d-flex.align-items-center.gap-3.mb-4
        = link_to store_store_baitos_path(@store), class: "btn btn-outline-secondary btn-sm" do
          %i.fas.fa-arrow-left
          バイト一覧へ
        %h1.mb-0 バイトを設定
        %span.text-muted.small= @store.name

      - if @recipes.empty?
        .alert.alert-warning
          バイトを設定するには、先にレシピを登録してください。
          = link_to 'レシピを登録', new_store_store_recipe_path(@store), class: 'alert-link'
      - else
        .card.shadow-sm
          .card-body
            = render 'form'
