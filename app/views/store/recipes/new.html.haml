.container.py-4
  .row.justify-content-center
    .col-lg-6.col-md-8

      .d-flex.align-items-center.gap-3.mb-4
        = link_to store_store_recipes_path(@store), class: "btn btn-outline-secondary btn-sm" do
          %i.fas.fa-arrow-left
          レシピ一覧へ
        %h1.mb-0 レシピを登録
        %span.text-muted.small= @store.name

      - if @ingredient_names.empty?
        .alert.alert-warning
          中央卸売市場で商品を仕入れると、レシピに使えるようになります。
          = link_to '市場で仕入れる', market_store_town_path(@store.town), class: 'alert-link'
      - else
        .card.shadow-sm
          .card-body
            = form_with model: [@store, @recipe], url: store_store_recipes_path(@store) do |f|
              - if @recipe.errors.any?
                .alert.alert-danger
                  %ul.mb-0
                    - @recipe.errors.full_messages.each do |msg|
                      %li= msg

              .mb-3
                = f.label :name, 'レシピ名', class: 'form-label fw-bold'
                = f.text_field :name, class: 'form-control', placeholder: 'かぼちゃスープ'

              %hr
              .mb-3
                = f.label :item_category_id, '完成品の商品カテゴリ', class: 'form-label fw-bold'
                = f.select :item_category_id,
                    options_from_collection_for_select(@item_categories, :id, :name),
                    { prompt: '選択してください' },
                    { class: 'form-select' }

              %hr
              .mb-4
                %label.form-label.fw-bold 材料（複数選択可）
                .d-flex.flex-wrap.gap-2
                  - @ingredient_names.each_with_index do |name, i|
                    .form-check.form-check-inline
                      = check_box_tag 'recipe[ingredient_names][]', name, false, id: "ingredient_#{i}", class: 'form-check-input'
                      = label_tag "ingredient_#{i}", name, class: 'form-check-label'

              = f.submit '登録する', class: 'btn btn-primary w-100'
