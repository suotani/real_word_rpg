.container.py-4
  .row.justify-content-center
    .col-lg-5.col-md-7

      .d-flex.align-items-center.gap-3.mb-4
        = link_to bulk_new_store_store_stocks_path(@store), class: "btn btn-outline-secondary btn-sm" do
          %i.fas.fa-arrow-left
          商品選択へ
        %h1.mb-0 まとめて出品

      .card.shadow-sm.mb-3
        .card-body
          %h5.card-title= @name
          %p.mb-0
            平均仕入れ値:
            %strong= "#{@avg_cost}円"
          %p.mb-0.text-muted.small
            対象在庫:
            = "#{@unlisted_stocks.count}件"

      .card.shadow-sm
        .card-body
          - if flash[:alert]
            .alert.alert-danger= flash[:alert]

          = form_with url: bulk_create_store_store_stocks_path(@store), method: :post, local: true do |f|
            = hidden_field_tag :name, @name
            .mb-4
              = label_tag :price, '販売価格（円）', class: 'form-label fw-bold'
              = number_field_tag :price, nil, min: 1, class: 'form-control form-control-lg', placeholder: '価格を入力'
              %p.text-muted.small.mt-1 対象の未出品在庫すべてにこの価格が設定されます

            = submit_tag '決定', class: 'btn btn-warning w-100 fw-bold'
