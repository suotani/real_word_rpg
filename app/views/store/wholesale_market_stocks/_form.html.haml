= form_with model: stock, url: url, local: true do |f|
  - if stock.errors.any?
    .alert.alert-danger
      - stock.errors.full_messages.each do |msg|
        %div= msg

  .mb-3
    = f.label :name, '商品名', class: 'form-label fw-bold'
    = f.text_field :name, class: 'form-control'

  .row.g-3.mb-4
    .col-sm-6
      = f.label :cost, '仕入れ値（円）', class: 'form-label fw-bold'
      = f.number_field :cost, class: 'form-control', min: 0
    .col-sm-6
      = f.label :price, '販売価格（円）', class: 'form-label fw-bold'
      = f.number_field :price, class: 'form-control', min: 1

  = f.submit '保存', class: 'btn btn-primary'
  = link_to 'キャンセル', store_wholesale_market_stocks_path, class: 'btn btn-outline-secondary ms-2'
